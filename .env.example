# Copy to .env on the server. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Only for organization-scoped user keys (sk-ant-usr-…): the workspace to bill/run in.
#ANTHROPIC_WORKSPACE_ID=wrkspc_...
ELEVENLABS_API_KEY=sk_...
# Long random string: `openssl rand -hex 32`
SECRET_KEY=change-me
# Your domain (DNS A record → server IP). Use `localhost` for a local run without HTTPS.
DOMAIN=editor.example.com
# Optional
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
ALLOW_SIGNUP=true
# Stop a user once their recorded spend reaches this (USD). 0 = no cap.
USER_BUDGET_USD=0
MAX_UPLOAD_MB=1024

# ---- Credits & admin ----
# These emails get the 管理後台 (comma-separated).
ADMIN_EMAILS=you@example.com
# Lemon Squeezy hosted checkout: one "Buy" URL per pack id (p500, p1000, p3000, p10000),
# the product variant id → pack id map, and the webhook signing secret.
# Webhook URL to register in Lemon Squeezy: https://<DOMAIN>/api/webhooks/lemonsqueezy (event: order_created)
# Leave these empty to sell manually: admins grant credits in the back office after a transfer.
CHECKOUT_URLS={}
LS_VARIANTS={}
LEMONSQUEEZY_WEBHOOK_SECRET=
# Shown on the 儲值 page when no checkout URL is configured.
TOPUP_NOTE=儲值請轉帳到 XXX 銀行 000-0000，並 LINE 通知客服，入帳後點數會自動出現。
# Optional override of the point prices, e.g. {"tool_points": {"make_cover": 5}, "free_revision_turns": 4}
# PRICING_JSON=
