server {
    listen ${PORT};
    listen [::]:${PORT};
    client_max_body_size 5g;
    root /usr/share/nginx/html;

    # Resolve the backend at request time (not at startup), so nginx starts even when the backend
    # is still deploying, and follows IP changes. RESOLVER: Docker's embedded DNS (127.0.0.11) by
    # default; on Railway's private network set RESOLVER=[fd12::10].
    resolver ${RESOLVER} valid=10s ipv6=on;

    location /api/ {
        set $upstream http://${API_UPSTREAM};
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;            # SSE
        proxy_read_timeout 3600s;       # long tool runs
        proxy_request_buffering off;    # large uploads stream through
    }
    # Share links: social crawlers (Facebook, LINE, Threads, Slack…) can't run the SPA, so they get a
    # server-rendered Open Graph page from the backend; browsers get the app as usual.
    location ~ ^/s/([A-Za-z0-9_-]+)$ {
        if ($http_user_agent ~* "(facebookexternalhit|facebot|twitterbot|linkedinbot|line-poker|linebot|slackbot|whatsapp|telegrambot|discordbot|threads|pinterest|embedly|skypeuripreview)") {
            rewrite ^/s/(.*)$ /api/og/s/$1 last;
        }
        try_files $uri /index.html;
    }
    location / {
        try_files $uri /index.html;
    }
}
